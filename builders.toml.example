default = "ec2"

[remotes.ec2]
# `wasinix remote list` shows this verbatim. Name the workload, availability,
# and constraints so an agent can choose the route without guessing.
description = "24/7 host builder for CI-scale work; 32 slots"
host = "nixremote@example"
key = "~/.ssh/nixremote_ed25519"
# Pin the host's ssh key (a known_hosts public-key line); without it the
# first connection trusts whatever key the host presents.
# host_key = "ssh-ed25519 AAAA..."
daemon_key = "/root/.ssh/nixremote_ed25519"
system = "x86_64-linux"
max_jobs = "32"
features = ["big-parallel", "benchmark"]
capabilities = ["builder", "store", "host"]
route = "host"
capacity = 1
max_load = 64
eval_workers = 4
eval_memory = 8192
substituters = ["https://nix-cache.wasix.org"]
trusted_public_keys = ["wasinix-1:jvsqbOJGsZxMvg97fuyNCWCc+t2nn6uHB47kQCGNmXI="]

[remotes.nixbuild]
description = "Metered elastic store for isolated Nix builds; avoid wide sweeps"
host = "account@nixbuild.net"
key = "~/.ssh/nixbuild"
capabilities = ["store"]
route = "store"
capacity = 2
eval_workers = 2
eval_memory = 8192

# Limits for `--on local`; each env var (WASINIX_MAX_JOBS, ...) overrides
# per invocation. capacity bounds concurrent local runs; unset = unlimited.
# [local]
# max_jobs = 8
# eval_workers = 2
# eval_memory = 8192
# capacity = 1
