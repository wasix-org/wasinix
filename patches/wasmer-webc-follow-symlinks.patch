From 6a4e4bf3e9b34f9052ae938840babed9ef688681 Mon Sep 17 00:00:00 2001
From: kilyanni <github@nkilian.org>
Date: Fri, 10 Jul 2026 00:59:41 +0200
Subject: [PATCH] fix(virtual-fs): follow symlinks when opening files in a webc
 volume

WebcVolumeFileSystem::open() looked at raw (non-following) metadata, so a
symlink resolved to Err(NotAFile): the volume stores symlinks
(WebcMetadata::Symlink, read_link) but open() never followed them. Exec'ing
a symlinked binary (e.g. git's libexec/git-core/git -> ../../bin/git.wasm)
therefore failed with ENOEXEC ("cannot execute binary file"), while the same
tree on a real fs works.

Resolve symlinks (relative targets against the link's parent, bounded loop)
before opening, matching real-fs semantics.
---
 lib/virtual-fs/src/webc_volume_fs.rs | 42 ++++++++++++++++++++++++++++
 1 file changed, 42 insertions(+)

diff --git a/lib/virtual-fs/src/webc_volume_fs.rs b/lib/virtual-fs/src/webc_volume_fs.rs
index 7ed7af27003..08baffecb5b 100644
--- a/lib/virtual-fs/src/webc_volume_fs.rs
+++ b/lib/virtual-fs/src/webc_volume_fs.rs
@@ -33,6 +33,44 @@ impl WebcVolumeFileSystem {
         &self.volume
     }
 
+    /// Follow symlinks to their final target within this volume, so callers that
+    /// need the underlying file (e.g. exec resolving git's helper
+    /// `libexec/git-core/git -> ../../bin/git.wasm`) behave like a real fs.
+    /// Relative targets resolve against the link's parent; bounded to avoid loops.
+    fn resolve_symlinks(&self, path: &Path) -> Result<PathBuf, FsError> {
+        let mut current = normalize(path)
+            .map(|s| PathBuf::from(s.to_string()))
+            .map_err(|_| FsError::InvalidInput)?;
+        for _ in 0..40 {
+            let is_symlink = self
+                .volume()
+                .metadata(current.as_path())
+                .map(|m| m.is_symlink())
+                .unwrap_or(false);
+            if !is_symlink {
+                return Ok(current);
+            }
+            let (target, _) = self
+                .volume()
+                .read_link(current.as_path())
+                .ok_or(FsError::EntryNotFound)?;
+            let target = PathBuf::from(target);
+            let joined = if target.is_absolute() {
+                target
+            } else {
+                current
+                    .parent()
+                    .map(|p| p.join(&target))
+                    .unwrap_or(target)
+            };
+            current = normalize(joined.as_path())
+                .map(|s| PathBuf::from(s.to_string()))
+                .map_err(|_| FsError::InvalidInput)?;
+        }
+        // Too many levels of symlinks.
+        Err(FsError::InvalidInput)
+    }
+
     /// Get a filesystem where all [`Volume`]s in a [`Container`] are mounted to
     /// the root directory.
     pub fn mount_all(
@@ -173,6 +211,10 @@ impl FileOpener for WebcVolumeFileSystem {
         path: &Path,
         conf: &OpenOptionsConfig,
     ) -> crate::Result<Box<dyn crate::VirtualFile + Send + Sync + 'static>> {
+        // Follow symlinks so opening (and exec'ing) a symlinked file resolves to
+        // its target, matching a real filesystem.
+        let resolved = self.resolve_symlinks(path)?;
+        let path = resolved.as_path();
         if let Some(parent) = path.parent() {
             let parent_meta = self.metadata(parent)?;
             if !parent_meta.is_dir() {
