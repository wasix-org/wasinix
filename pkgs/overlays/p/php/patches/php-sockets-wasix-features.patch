diff --git a/ext/sockets/conversions.h b/ext/sockets/conversions.h
index 1f1fd29c..2deb79c8 100644
--- a/ext/sockets/conversions.h
+++ b/ext/sockets/conversions.h
@@ -22 +22,23 @@
-#include "php_sockets.h"
+#include "php_sockets.h"
+
+#if defined(__wasi__) && !defined(CMSG_DATA)
+struct cmsghdr {
+	socklen_t cmsg_len;
+	int cmsg_level;
+	int cmsg_type;
+};
+
+#define PHP_CMSG_ALIGN(length) (((length) + sizeof(size_t) - 1) & ~(sizeof(size_t) - 1))
+#define CMSG_DATA(cmsg) ((unsigned char *)((struct cmsghdr *)(cmsg) + 1))
+#define CMSG_SPACE(length) (sizeof(struct cmsghdr) + PHP_CMSG_ALIGN(length))
+#define CMSG_LEN(length) (sizeof(struct cmsghdr) + (length))
+#define CMSG_FIRSTHDR(message) \
+	((message)->msg_controllen >= sizeof(struct cmsghdr) \
+		? (struct cmsghdr *)(message)->msg_control \
+		: NULL)
+#define CMSG_NXTHDR(message, cmsg) \
+	((((unsigned char *)(cmsg) + PHP_CMSG_ALIGN((cmsg)->cmsg_len) + sizeof(struct cmsghdr)) \
+		<= ((unsigned char *)(message)->msg_control + (message)->msg_controllen)) \
+		? (struct cmsghdr *)((unsigned char *)(cmsg) + PHP_CMSG_ALIGN((cmsg)->cmsg_len)) \
+		: NULL)
+#endif
