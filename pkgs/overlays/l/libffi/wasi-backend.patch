+
+static ffi_status impl_closure_prepare(
+    void *backing_function,
+    void *code,
+    uint8_t *argument_types_ptr,
+    size_t argument_types_len,
+    uint8_t *result_types_ptr,
+    size_t result_types_len,
+    void *user_data_ptr
