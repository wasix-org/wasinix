diff --git a/CMakeLists.txt b/CMakeLists.txt
index 16f6349e6f1f..e3628309b3a0 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -49,1 +49,7 @@ project(LLVM
+# Rust bootstrap uses Generic for WASIX cross builds. LLVM's support layer is
+# nevertheless the Unix implementation supplied by wasix-libc.
+if(LLVM_DEFAULT_TARGET_TRIPLE MATCHES "wasm32.*wasi")
+  set(UNIX ON)
+endif()
+
 if (NOT DEFINED CMAKE_INSTALL_LIBDIR AND DEFINED LLVM_LIBDIR_SUFFIX)
diff --git a/lib/Support/Unix/Path.inc b/lib/Support/Unix/Path.inc
index 00e140092230..49872bd791c7 100644
--- a/lib/Support/Unix/Path.inc
+++ b/lib/Support/Unix/Path.inc
@@ -126,7 +126,7 @@ const file_t kInvalidFile = -1;
     defined(__CYGWIN__) || defined(__DragonFly__) || defined(_AIX) ||          \
     defined(__GNU__) ||                                                        \
     (defined(__sun__) && defined(__svr4__) || defined(__HAIKU__)) ||           \
-    defined(__managarm__)
+    defined(__managarm__) || defined(__wasi__)
 static int test_dir(char ret[PATH_MAX], const char *dir, const char *bin) {
   struct stat sb;
   char fullpath[PATH_MAX];
@@ -323,6 +323,12 @@ std::string getMainExecutable(const char *argv0, void *MainAddr) {
       return std::string(real_path);
     break; // Found entry, but realpath failed.
   }
+#elif defined(__wasi__)
+  char exe_path[PATH_MAX];
+  // WASIX has no process filesystem or dynamic loader. Resolve argv[0]
+  // against the current directory and PATH instead.
+  if (getprogpath(exe_path, argv0) != nullptr)
+    return exe_path;
 #elif defined(HAVE_DLOPEN)
   // Use dladdr to get executable path if available.
   Dl_info DLInfo;
@@ -510,8 +516,8 @@ static bool is_local_impl(struct STATVFS &Vfs) {
 #elif defined(__Fuchsia__)
   // Fuchsia doesn't yet support remote filesystem mounts.
   return true;
-#elif defined(__EMSCRIPTEN__)
-  // Emscripten doesn't currently support remote filesystem mounts.
+#elif defined(__EMSCRIPTEN__) || defined(__wasi__)
+  // Emscripten and WASIX don't currently support remote filesystem mounts.
   return true;
 #elif defined(__HAIKU__)
   // Haiku doesn't expose this information.
@@ -922,7 +928,7 @@ void mapped_file_region::dontNeedImpl() {
   assert(Mode == mapped_file_region::readonly);
   if (!Mapping)
     return;
-#if defined(__MVS__) || defined(_AIX)
+#if defined(__MVS__) || defined(_AIX) || defined(__wasi__)
     // If we don't have madvise, or it isn't beneficial, treat this as a no-op.
 #elif defined(POSIX_MADV_DONTNEED)
   ::posix_madvise(Mapping, Size, POSIX_MADV_DONTNEED);
@@ -937,7 +943,7 @@ void mapped_file_region::willNeedImpl() {
   assert(Mode == mapped_file_region::readonly);
   if (!Mapping)
     return;
-#if defined(__MVS__) || defined(_AIX)
+#if defined(__MVS__) || defined(_AIX) || defined(__wasi__)
   // If we don't have madvise, or it isn't beneficial, treat this as a no-op.
 #elif defined(POSIX_MADV_WILLNEED)
   ::posix_madvise(Mapping, Size, POSIX_MADV_WILLNEED);
