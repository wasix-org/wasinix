index 00000000..ae4baa08
--- /dev/null
+++ b/lib/wasix/src/fs/locks.rs
@@ -0,0 +1,567 @@
+use std::{
+    collections::HashMap,
+    future::Future,
+    pin::Pin,
+    sync::{Arc, Mutex, Weak},
+    task::{Context, Poll, Waker},
+};
+
+use wasmer_wasix_types::wasi::Errno;
+
+use super::Inode;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum FileLockType {
+    Read,
+    Write,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct FileLockRange {
+    pub start: u64,
+    pub end: u64,
+}
+
+impl FileLockRange {
+    fn overlaps(self, other: Self) -> bool {
+        self.start < other.end && other.start < self.end
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct PosixFileLock {
+    pub owner: u32,
+    pub lock_type: FileLockType,
+    pub range: FileLockRange,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum PosixLockOperation {
+    Get,
+    Set,
+    SetWait,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum FlockOperation {
+    Shared,
+    Exclusive,
+    Unlock,
+}
+
+#[derive(Debug, Clone, Copy)]
+struct FlockEntry {
+    owner: u64,
+    exclusive: bool,
+}
+
+#[derive(Debug, Default)]
+struct FileLockState {
+    posix: HashMap<Inode, Vec<PosixFileLock>>,
+    flock: HashMap<Inode, Vec<FlockEntry>>,
+    waiters: HashMap<u64, Waker>,
+    next_waiter: u64,
+    next_description: u64,
+}
+
+#[derive(Debug, Default)]
+pub(crate) struct FileLockManager {
+    state: Mutex<FileLockState>,
+}
+
+#[derive(Debug)]
+pub(crate) struct OpenFileDescription {
+    id: u64,
+    locks: Weak<FileLockManager>,
+}
+
+impl OpenFileDescription {
+    pub(crate) fn id(&self) -> u64 {
+        self.id
+    }
+
+    #[cfg(test)]
+    pub(crate) fn detached() -> Arc<Self> {
+        Arc::new(Self {
+            id: 0,
+            locks: Weak::new(),
+        })
+    }
+}
+
+impl Drop for OpenFileDescription {
+    fn drop(&mut self) {
+        if let Some(locks) = self.locks.upgrade() {
+            locks.release_flock_owner(self.id);
+        }
+    }
+}
+
+impl FileLockManager {
+    pub(crate) fn open_description(self: &Arc<Self>) -> Arc<OpenFileDescription> {
+        let id = {
+            let mut state = self.state.lock().unwrap();
+            state.next_description = state.next_description.wrapping_add(1).max(1);
+            state.next_description
+        };
+        Arc::new(OpenFileDescription {
+            id,
+            locks: Arc::downgrade(self),
+        })
+    }
+
+    pub(crate) fn posix(
+        self: &Arc<Self>,
+        inode: Inode,
+        operation: PosixLockOperation,
+        requested: PosixFileLock,
+    ) -> Result<Option<PosixFileLock>, Errno> {
+        let mut state = self.state.lock().unwrap();
+        let conflict = state
+            .posix
+            .get(&inode)
+            .and_then(|locks| posix_conflict(locks, requested));
+
+        match operation {
+            PosixLockOperation::Get => Ok(conflict),
+            PosixLockOperation::Set | PosixLockOperation::SetWait => {
+                if conflict.is_some() {
+                    return Err(Errno::Again);
+                }
+                apply_posix_lock(state.posix.entry(inode).or_default(), requested);
+                wake_waiters(&mut state);
+                Ok(None)
+            }
+        }
+    }
+
+    pub(crate) fn posix_wait(
+        self: &Arc<Self>,
+        inode: Inode,
+        requested: PosixFileLock,
+    ) -> PosixLockFuture {
+        PosixLockFuture {
+            locks: self.clone(),
+            inode,
+            requested,
+            waiter: None,
+        }
+    }
+
+    pub(crate) fn release_posix_inode(&self, inode: Inode, owner: u32) {
+        let mut state = self.state.lock().unwrap();
+        let Some(locks) = state.posix.get_mut(&inode) else {
+            return;
+        };
+        let old_len = locks.len();
+        locks.retain(|lock| lock.owner != owner);
+        let changed = old_len != locks.len();
+        if locks.is_empty() {
+            state.posix.remove(&inode);
+        }
+        if changed {
+            wake_waiters(&mut state);
+        }
+    }
+
+    pub(crate) fn unlock_posix(&self, inode: Inode, owner: u32, range: FileLockRange) {
+        let mut state = self.state.lock().unwrap();
+        let Some(locks) = state.posix.get_mut(&inode) else {
+            return;
+        };
+        let changed = remove_posix_range(locks, owner, range);
+        if locks.is_empty() {
+            state.posix.remove(&inode);
+        }
+        if changed {
+            wake_waiters(&mut state);
+        }
+    }
+
+    pub(crate) fn release_posix_owner(&self, owner: u32) {
+        let mut state = self.state.lock().unwrap();
+        let mut changed = false;
+        state.posix.retain(|_, locks| {
+            let old_len = locks.len();
+            locks.retain(|lock| lock.owner != owner);
+            changed |= old_len != locks.len();
+            !locks.is_empty()
+        });
+        if changed {
+            wake_waiters(&mut state);
+        }
+    }
+
+    pub(crate) fn flock(
+        self: &Arc<Self>,
+        inode: Inode,
+        owner: u64,
+        operation: FlockOperation,
+    ) -> Result<(), Errno> {
+        let mut state = self.state.lock().unwrap();
+        if operation == FlockOperation::Unlock {
+            let changed = remove_flock_owner(&mut state.flock, inode, owner);
+            if changed {
+                wake_waiters(&mut state);
+            }
+            return Ok(());
+        }
+
+        let entries = state.flock.entry(inode).or_default();
+        let old_len = entries.len();
+        entries.retain(|entry| entry.owner != owner);
+        let released = old_len != entries.len();
+        let conflict = entries
+            .iter()
+            .any(|entry| entry.exclusive || operation == FlockOperation::Exclusive);
+        if conflict {
+            if released {
+                wake_waiters(&mut state);
+            }
+            return Err(Errno::Again);
+        }
+
+        entries.push(FlockEntry {
+            owner,
+            exclusive: operation == FlockOperation::Exclusive,
+        });
+        wake_waiters(&mut state);
+        Ok(())
+    }
+
+    pub(crate) fn flock_wait(
+        self: &Arc<Self>,
+        inode: Inode,
+        owner: u64,
+        operation: FlockOperation,
+    ) -> FlockFuture {
+        FlockFuture {
+            locks: self.clone(),
+            inode,
+            owner,
+            operation,
+            waiter: None,
+        }
+    }
+
+    fn release_flock_owner(&self, owner: u64) {
+        let mut state = self.state.lock().unwrap();
+        let mut changed = false;
+        state.flock.retain(|_, entries| {
+            let old_len = entries.len();
+            entries.retain(|entry| entry.owner != owner);
+            changed |= old_len != entries.len();
+            !entries.is_empty()
+        });
+        if changed {
+            wake_waiters(&mut state);
+        }
+    }
+
+    fn register_waiter(state: &mut FileLockState, waiter: &mut Option<u64>, waker: &Waker) {
+        let id = *waiter.get_or_insert_with(|| {
+            state.next_waiter = state.next_waiter.wrapping_add(1).max(1);
+            state.next_waiter
+        });
+        state.waiters.insert(id, waker.clone());
+    }
+
+    fn remove_waiter(&self, waiter: Option<u64>) {
+        if let Some(waiter) = waiter {
+            self.state.lock().unwrap().waiters.remove(&waiter);
+        }
+    }
+}
+
+pub(crate) struct PosixLockFuture {
+    locks: Arc<FileLockManager>,
+    inode: Inode,
+    requested: PosixFileLock,
+    waiter: Option<u64>,
+}
+
+impl Future for PosixLockFuture {
+    type Output = Result<(), Errno>;
+
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        let locks = self.locks.clone();
+        let mut state = locks.state.lock().unwrap();
+        let conflict = state
+            .posix
+            .get(&self.inode)
+            .and_then(|entries| posix_conflict(entries, self.requested));
+        if conflict.is_none() {
+            apply_posix_lock(state.posix.entry(self.inode).or_default(), self.requested);
+            if let Some(waiter) = self.waiter.take() {
+                state.waiters.remove(&waiter);
+            }
+            wake_waiters(&mut state);
+            return Poll::Ready(Ok(()));
+        }
+        FileLockManager::register_waiter(&mut state, &mut self.waiter, cx.waker());
+        Poll::Pending
+    }
+}
+
+impl Drop for PosixLockFuture {
+    fn drop(&mut self) {
+        self.locks.remove_waiter(self.waiter);
+    }
+}
+
+pub(crate) struct FlockFuture {
+    locks: Arc<FileLockManager>,
+    inode: Inode,
+    owner: u64,
+    operation: FlockOperation,
+    waiter: Option<u64>,
+}
+
+impl Future for FlockFuture {
+    type Output = Result<(), Errno>;
+
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        let locks = self.locks.clone();
+        let mut state = locks.state.lock().unwrap();
+        let entries = state.flock.entry(self.inode).or_default();
+        let old_len = entries.len();
+        entries.retain(|entry| entry.owner != self.owner);
+        let released = old_len != entries.len();
+        let conflict = entries
+            .iter()
+            .any(|entry| entry.exclusive || self.operation == FlockOperation::Exclusive);
+        if !conflict {
+            entries.push(FlockEntry {
+                owner: self.owner,
+                exclusive: self.operation == FlockOperation::Exclusive,
+            });
+            if let Some(waiter) = self.waiter.take() {
+                state.waiters.remove(&waiter);
+            }
+            wake_waiters(&mut state);
+            return Poll::Ready(Ok(()));
+        }
+        if released {
+            wake_waiters(&mut state);
+        }
+        FileLockManager::register_waiter(&mut state, &mut self.waiter, cx.waker());
+        Poll::Pending
+    }
+}
+
+impl Drop for FlockFuture {
+    fn drop(&mut self) {
+        self.locks.remove_waiter(self.waiter);
+    }
+}
+
+fn posix_conflict(locks: &[PosixFileLock], requested: PosixFileLock) -> Option<PosixFileLock> {
+    locks
+        .iter()
+        .copied()
+        .filter(|lock| {
+            lock.owner != requested.owner
+                && lock.range.overlaps(requested.range)
+                && (lock.lock_type == FileLockType::Write
+                    || requested.lock_type == FileLockType::Write)
+        })
+        .min_by_key(|lock| lock.range.start)
+}
+
+fn apply_posix_lock(locks: &mut Vec<PosixFileLock>, requested: PosixFileLock) {
+    let mut replacement = Vec::with_capacity(locks.len() + 1);
+    for lock in locks.drain(..) {
+        if lock.owner != requested.owner || !lock.range.overlaps(requested.range) {
+            replacement.push(lock);
+            continue;
+        }
+        if lock.range.start < requested.range.start {
+            replacement.push(PosixFileLock {
+                range: FileLockRange {
+                    start: lock.range.start,
+                    end: requested.range.start,
+                },
+                ..lock
+            });
+        }
+        if requested.range.end < lock.range.end {
+            replacement.push(PosixFileLock {
+                range: FileLockRange {
+                    start: requested.range.end,
+                    end: lock.range.end,
+                },
+                ..lock
+            });
+        }
+    }
+    replacement.push(requested);
+    replacement.sort_by_key(|lock| lock.range.start);
+    *locks = replacement;
+}
+
+fn remove_posix_range(locks: &mut Vec<PosixFileLock>, owner: u32, range: FileLockRange) -> bool {
+    let old = locks.clone();
+    let mut replacement = Vec::with_capacity(locks.len() + 1);
+    for lock in locks.drain(..) {
+        if lock.owner != owner || !lock.range.overlaps(range) {
+            replacement.push(lock);
+            continue;
+        }
+        if lock.range.start < range.start {
+            replacement.push(PosixFileLock {
+                range: FileLockRange {
+                    start: lock.range.start,
+                    end: range.start,
+                },
+                ..lock
+            });
+        }
+        if range.end < lock.range.end {
+            replacement.push(PosixFileLock {
+                range: FileLockRange {
+                    start: range.end,
+                    end: lock.range.end,
+                },
+                ..lock
+            });
+        }
+    }
+    replacement.sort_by_key(|lock| lock.range.start);
+    let changed = old != replacement;
+    *locks = replacement;
+    changed
+}
+
+fn remove_flock_owner(
+    flock: &mut HashMap<Inode, Vec<FlockEntry>>,
+    inode: Inode,
+    owner: u64,
+) -> bool {
+    let Some(entries) = flock.get_mut(&inode) else {
+        return false;
+    };
+    let old_len = entries.len();
+    entries.retain(|entry| entry.owner != owner);
+    let changed = old_len != entries.len();
+    if entries.is_empty() {
+        flock.remove(&inode);
+    }
+    changed
+}
+
+fn wake_waiters(state: &mut FileLockState) {
+    for (_, waiter) in state.waiters.drain() {
+        waiter.wake();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn range(start: u64, end: u64) -> FileLockRange {
+        FileLockRange { start, end }
+    }
+
+    fn lock(owner: u32, lock_type: FileLockType, start: u64, end: u64) -> PosixFileLock {
+        PosixFileLock {
+            owner,
+            lock_type,
+            range: range(start, end),
+        }
+    }
+
+    #[test]
+    fn posix_locks_conflict_between_owners() {
+        let manager = Arc::new(FileLockManager::default());
+        let inode = Inode(1);
+        manager
+            .posix(
+                inode,
+                PosixLockOperation::Set,
+                lock(1, FileLockType::Write, 10, 20),
+            )
+            .unwrap();
+
+        let requested = lock(2, FileLockType::Read, 15, 25);
+        assert_eq!(
+            manager.posix(inode, PosixLockOperation::Get, requested),
+            Ok(Some(lock(1, FileLockType::Write, 10, 20)))
+        );
+        assert_eq!(
+            manager.posix(inode, PosixLockOperation::Set, requested),
+            Err(Errno::Again)
+        );
+    }
+
+    #[test]
+    fn posix_unlock_splits_a_range() {
+        let manager = Arc::new(FileLockManager::default());
+        let inode = Inode(1);
+        manager
+            .posix(
+                inode,
+                PosixLockOperation::Set,
+                lock(1, FileLockType::Write, 10, 30),
+            )
+            .unwrap();
+        manager.unlock_posix(inode, 1, range(15, 25));
+
+        assert_eq!(
+            manager.state.lock().unwrap().posix[&inode],
+            [
+                lock(1, FileLockType::Write, 10, 15),
+                lock(1, FileLockType::Write, 25, 30),
+            ]
+        );
+    }
+
+    #[test]
+    fn closing_any_descriptor_releases_process_locks_for_the_inode() {
+        let manager = Arc::new(FileLockManager::default());
+        let inode = Inode(1);
+        manager
+            .posix(
+                inode,
+                PosixLockOperation::Set,
+                lock(1, FileLockType::Write, 0, 10),
+            )
+            .unwrap();
+        manager.release_posix_inode(inode, 1);
+
+        assert!(!manager.state.lock().unwrap().posix.contains_key(&inode));
+    }
+
+    #[test]
+    fn flock_follows_open_file_description_lifetime() {
+        let manager = Arc::new(FileLockManager::default());
+        let inode = Inode(1);
+        let description = manager.open_description();
+        let duplicate = description.clone();
+        manager
+            .flock(inode, description.id(), FlockOperation::Exclusive)
+            .unwrap();
+        drop(description);
+
+        assert_eq!(
+            manager.flock(inode, 2, FlockOperation::Exclusive),
+            Err(Errno::Again)
+        );
+        drop(duplicate);
+        assert_eq!(manager.flock(inode, 2, FlockOperation::Exclusive), Ok(()));
+    }
+
+    #[test]
+    fn flock_conversion_releases_the_previous_lock_before_waiting() {
+        let manager = Arc::new(FileLockManager::default());
+        let inode = Inode(1);
+        manager.flock(inode, 1, FlockOperation::Shared).unwrap();
+        manager.flock(inode, 2, FlockOperation::Shared).unwrap();
+
+        assert_eq!(
+            manager.flock(inode, 1, FlockOperation::Exclusive),
+            Err(Errno::Again)
+        );
+        assert_eq!(manager.flock(inode, 2, FlockOperation::Exclusive), Ok(()));
+    }
+}
