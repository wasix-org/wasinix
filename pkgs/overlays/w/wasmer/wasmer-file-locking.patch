diff --git a/lib/wasix/src/syscalls/wasix/fd_lock.rs b/lib/wasix/src/syscalls/wasix/fd_lock.rs
new file mode 100644
index 00000000..78ba0641
--- /dev/null
+++ b/lib/wasix/src/syscalls/wasix/fd_lock.rs
@@ -0,0 +1,185 @@
+use std::sync::atomic::Ordering;
+
+use super::*;
+use crate::{
+    fs::{FileLockRange, FileLockType, FlockOperation, Kind, PosixFileLock, PosixLockOperation},
+    syscalls::*,
+};
+
+const LOCK_GET: u32 = 0;
+const LOCK_SET: u32 = 1;
+const LOCK_SET_WAIT: u32 = 2;
+const LOCK_READ: u32 = 0;
+const LOCK_WRITE: u32 = 1;
+const LOCK_UNLOCK: u32 = 2;
+const SEEK_SET: u32 = 0;
+const SEEK_CUR: u32 = 1;
+const SEEK_END: u32 = 2;
+
+pub fn fd_lock<M: MemorySize>(
+    mut ctx: FunctionEnvMut<'_, WasiEnv>,
+    fd: WasiFd,
+    operation: u32,
+    lock_type: u32,
+    whence: u32,
+    start: i64,
+    len: i64,
+    result_type: WasmPtr<u32, M>,
+    result_whence: WasmPtr<u32, M>,
+    result_start: WasmPtr<i64, M>,
+    result_len: WasmPtr<i64, M>,
+    result_pid: WasmPtr<u32, M>,
+) -> Result<Errno, WasiError> {
+    WasiEnv::do_pending_operations(&mut ctx)?;
+
+    let env = ctx.data();
+    let entry = wasi_try_ok!(env.state.fs.get_fd(fd));
+    let inode = entry.inode.ino();
+    if !matches!(&*entry.inode.read(), Kind::File { .. }) {
+        return Ok(Errno::Badf);
+    }
+
+    let operation = match operation {
+        LOCK_GET => PosixLockOperation::Get,
+        LOCK_SET => PosixLockOperation::Set,
+        LOCK_SET_WAIT => PosixLockOperation::SetWait,
+        _ => return Ok(Errno::Inval),
+    };
+    let range = wasi_try_ok!(lock_range(&entry, whence, start, len));
+    let owner = env.pid().raw();
+    let manager = env.state.fs.root_fs.file_locks.clone();
+
+    if lock_type == LOCK_UNLOCK {
+        if operation == PosixLockOperation::Get {
+            return Ok(Errno::Inval);
+        }
+        manager.unlock_posix(inode, owner, range);
+        return Ok(Errno::Success);
+    }
+
+    let lock_type = match lock_type {
+        LOCK_READ => {
+            if !entry.inner.rights.contains(Rights::FD_READ) {
+                return Ok(Errno::Badf);
+            }
+            FileLockType::Read
+        }
+        LOCK_WRITE => {
+            if !entry.inner.rights.contains(Rights::FD_WRITE) {
+                return Ok(Errno::Badf);
+            }
+            FileLockType::Write
+        }
+        _ => return Ok(Errno::Inval),
+    };
+    let requested = PosixFileLock {
+        owner,
+        lock_type,
+        range,
+    };
+
+    if operation == PosixLockOperation::SetWait {
+        wasi_try_ok!(__asyncify(
+            &mut ctx,
+            None,
+            manager.posix_wait(inode, requested)
+        )?);
+        return Ok(Errno::Success);
+    }
+
+    let conflict = wasi_try_ok!(manager.posix(inode, operation, requested));
+    if operation == PosixLockOperation::Get {
+        let memory = unsafe { ctx.data().memory_view(&ctx) };
+        match conflict {
+            Some(conflict) => {
+                let lock_type = match conflict.lock_type {
+                    FileLockType::Read => LOCK_READ,
+                    FileLockType::Write => LOCK_WRITE,
+                };
+                let len = if conflict.range.end == u64::MAX {
+                    0
+                } else {
+                    wasi_try_ok!(
+                        i64::try_from(conflict.range.end - conflict.range.start)
+                            .map_err(|_| Errno::Overflow)
+                    )
+                };
+                wasi_try_mem_ok!(result_type.write(&memory, lock_type));
+                wasi_try_mem_ok!(result_whence.write(&memory, SEEK_SET));
+                wasi_try_mem_ok!(result_start.write(
+                    &memory,
+                    wasi_try_ok!(i64::try_from(conflict.range.start).map_err(|_| Errno::Overflow))
+                ));
+                wasi_try_mem_ok!(result_len.write(&memory, len));
+                wasi_try_mem_ok!(result_pid.write(&memory, conflict.owner));
+            }
+            None => {
+                wasi_try_mem_ok!(result_type.write(&memory, LOCK_UNLOCK));
+            }
+        }
+    }
+
+    Ok(Errno::Success)
+}
+
+pub fn fd_flock(
+    mut ctx: FunctionEnvMut<'_, WasiEnv>,
+    fd: WasiFd,
+    operation: u32,
+) -> Result<Errno, WasiError> {
+    WasiEnv::do_pending_operations(&mut ctx)?;
+
+    let env = ctx.data();
+    let entry = wasi_try_ok!(env.state.fs.get_fd(fd));
+    if !matches!(&*entry.inode.read(), Kind::File { .. }) {
+        return Ok(Errno::Badf);
+    }
+    let nonblocking = operation & 4 != 0;
+    let operation = match operation & !4 {
+        1 => FlockOperation::Shared,
+        2 => FlockOperation::Exclusive,
+        8 => FlockOperation::Unlock,
+        _ => return Ok(Errno::Inval),
+    };
+    let inode = entry.inode.ino();
+    let owner = entry.inner.description.id();
+    let manager = env.state.fs.root_fs.file_locks.clone();
+
+    if nonblocking || operation == FlockOperation::Unlock {
+        return Ok(match manager.flock(inode, owner, operation) {
+            Ok(()) => Errno::Success,
+            Err(err) => err,
+        });
+    }
+
+    wasi_try_ok!(__asyncify(
+        &mut ctx,
+        None,
+        manager.flock_wait(inode, owner, operation)
+    )?);
+    Ok(Errno::Success)
+}
+
+fn lock_range(fd: &Fd, whence: u32, start: i64, len: i64) -> Result<FileLockRange, Errno> {
+    let base = match whence {
+        SEEK_SET => 0,
+        SEEK_CUR => fd.inner.offset.load(Ordering::Acquire),
+        SEEK_END => fd.inode.stat.read().unwrap().st_size,
+        _ => return Err(Errno::Inval),
+    };
+    let anchor = i128::from(base) + i128::from(start);
+    let (start, end) = if len == 0 {
+        (anchor, i128::from(u64::MAX))
+    } else if len > 0 {
+        (anchor, anchor + i128::from(len))
+    } else {
+        (anchor + i128::from(len), anchor)
+    };
+    if start < 0 || end <= start || end > i128::from(u64::MAX) {
+        return Err(Errno::Inval);
+    }
+    Ok(FileLockRange {
+        start: start as u64,
+        end: end as u64,
+    })
+}
