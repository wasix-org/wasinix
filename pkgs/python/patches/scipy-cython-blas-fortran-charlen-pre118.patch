The same change as scipy-cython-blas-fortran-charlen.patch, cut against the
_generate_pyx.py layout scipy used up to 1.17: flang emits the standard F77
hidden-length ABI for CHARACTER dummy arguments and scipy's cython_blas /
cython_lapack wrappers omit them, which traps under wasm's strictly-typed
call_indirect (signature_mismatch:dgemm_).

diff -ruN a/scipy/linalg/_generate_pyx.py b/scipy/linalg/_generate_pyx.py
--- a/scipy/linalg/_generate_pyx.py	2026-08-11 15:49:51.735375900 +0200
+++ b/scipy/linalg/_generate_pyx.py	2026-08-11 15:49:51.735616261 +0200
@@ -410,6 +410,18 @@
     if name in WRAPPED_FUNCS:
         pyx_call_args[0] = ''.join([arg_casts(c_argtypes[0]), '&', argnames[0]])
     pyx_call_args = ', '.join(pyx_call_args)
+    # WASIX: flang emits the standard F77 hidden-length ABI for CHARACTER args
+    # (one trailing size_t per char arg). These cython wrappers omit them, which
+    # is harmless where a lax C ABI ignores extra args but traps under wasm's
+    # strictly-typed call_indirect. Append them so the wasm signature matches the
+    # flang reference BLAS/LAPACK. Every wrapped char arg is a CHARACTER*1 flag
+    # (ilaenv/xerbla are not wrapped), so the length is always 1 and LSAME reads
+    # only the first character regardless. The public wrapper signature
+    # (pyx_input_args) is untouched, so consumers stay ABI-compatible.
+    n_charlen = c_argtypes.count('char')
+    if n_charlen:
+        c_proto += ''.join(f', size_t _charlen{i}' for i in range(n_charlen))
+        pyx_call_args += ', ' + ', '.join(['1'] * n_charlen)
     blas_macro, blas_name = get_blas_macro_and_name(name, accelerate)
     return f"""
 cdef extern from "{header_name}":
@@ -523,6 +535,10 @@
         c_return_type = 'void'
     blas_macro, blas_name = get_blas_macro_and_name(name, accelerate)
     c_args = ', '.join(f'{t} *{n}' for t, n in zip(c_argtypes, argnames))
+    # WASIX: match flang's hidden CHARACTER-length args (see generate_decl_pyx).
+    n_charlen = c_argtypes.count('char')
+    if n_charlen:
+        c_args += ''.join(f', size_t _charlen{i}' for i in range(n_charlen))
     return f"{c_return_type} {blas_macro}({blas_name})({c_args});\n"
 
 
@@ -534,7 +550,9 @@
         preamble = [C_PREAMBLE, LAPACK_DECLS]
     else:
         raise RuntimeError(f'Unrecognized lib_name: {lib_name}.')
-    preamble = ['/*\n', *COMMENT_TEXT, '*/\n'] + preamble + [CPP_GUARD_BEGIN]
+    preamble = ['/*\n', *COMMENT_TEXT, '*/\n',
+                '#include <stddef.h>  /* WASIX: size_t for hidden charlen args */\n'
+                ] + preamble + [CPP_GUARD_BEGIN]
     decls = [generate_decl_c(**sig, accelerate=accelerate) for sig in sigs]
     content = preamble + decls + [CPP_GUARD_END]
     return ''.join(content)
