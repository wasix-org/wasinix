# wasix is not browser wasm: libdatadog gates threads, sockets and its native
# (hyper) HTTP stack off for every wasm32 target, while ddtrace-native only ever
# builds NativeCapabilities. Narrow those cutouts to non-wasmer wasm32.

diff -ruN '--exclude=.cargo-checksum.json' a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml	1970-01-01 01:00:01.000000000 +0100
+++ b/Cargo.toml	2026-07-22 01:50:11.366692426 +0200
@@ -76,7 +76,7 @@
 version = "0.1"
 default-features = false
 
-[target."cfg(not(target_arch = \"wasm32\"))".dependencies.libdd-capabilities-impl]
+[target."cfg(any(not(target_arch = \"wasm32\"), target_vendor = \"wasmer\"))".dependencies.libdd-capabilities-impl]
 version = "2.0.0"
 path = "../libdd-capabilities-impl"
 default-features = false
diff -ruN '--exclude=.cargo-checksum.json' a/src/lib.rs b/src/lib.rs
--- a/src/lib.rs	1970-01-01 01:00:01.000000000 +0100
+++ b/src/lib.rs	2026-07-22 01:50:11.366931464 +0200
@@ -10,5 +10,5 @@
 //! This crate provides utilities to compute stats from traces.
 
 pub mod span_concentrator;
-#[cfg(not(target_arch = "wasm32"))]
+#[cfg(any(not(target_arch = "wasm32"), target_vendor = "wasmer"))]
 pub mod stats_exporter;
diff -ruN '--exclude=.cargo-checksum.json' a/src/span_concentrator/mod.rs b/src/span_concentrator/mod.rs
--- a/src/span_concentrator/mod.rs	1970-01-01 01:00:01.000000000 +0100
+++ b/src/span_concentrator/mod.rs	2026-07-22 01:50:11.368466798 +0200
@@ -55,7 +55,7 @@
 
 #[cfg(feature = "stats-obfuscation")]
 #[derive(Clone, Debug, Default)]
-#[cfg_attr(target_arch = "wasm32", allow(dead_code))]
+#[cfg_attr(all(target_arch = "wasm32", not(target_vendor = "wasmer")), allow(dead_code))]
 pub struct StatsComputationObfuscationConfig {
     pub enabled: bool,
     pub sql_obfuscation_mode: libdd_trace_obfuscation::sql::SqlObfuscationMode,
diff -ruN '--exclude=.cargo-checksum.json' a/src/stats_exporter.rs b/src/stats_exporter.rs
--- a/src/stats_exporter.rs	1970-01-01 01:00:01.000000000 +0100
+++ b/src/stats_exporter.rs	2026-07-22 01:50:11.367369076 +0200
@@ -205,8 +205,8 @@
     }
 }
 
-#[cfg_attr(not(target_arch = "wasm32"), async_trait)]
-#[cfg_attr(target_arch = "wasm32", async_trait(?Send))]
+#[cfg_attr(any(not(target_arch = "wasm32"), target_vendor = "wasmer"), async_trait)]
+#[cfg_attr(all(target_arch = "wasm32", not(target_vendor = "wasmer")), async_trait(?Send))]
 impl<
         Cap: HttpClientCapability + SleepCapability + MaybeSend + Sync + 'static,
         Con: FlushableConcentrator + Send + Debug,
