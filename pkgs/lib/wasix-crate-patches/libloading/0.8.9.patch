 extern "C" {
     fn dlopen(filename: *const raw::c_char, flags: raw::c_int) -> *mut raw::c_void;
     fn dlclose(handle: *mut raw::c_void) -> raw::c_int;
     fn dlsym(handle: *mut raw::c_void, symbol: *const raw::c_char) -> *mut raw::c_void;
     fn dlerror() -> *mut raw::c_char;
     fn dladdr(addr: *mut raw::c_void, info: *mut DlInfo) -> raw::c_int;
 }
 
 #[repr(C)]
 struct DlInfo {
     dli_fname: *const raw::c_char,
     dli_fbase: *mut raw::c_void,
     dli_sname: *const raw::c_char,
     dli_saddr: *mut raw::c_void,
 }
+
+#[cfg(all(target_os = "wasi", target_vendor = "wasmer", not(target_env = "dl")))]
+fn dl_unavailable() -> *mut raw::c_char {
+    b"dynamic loading is unavailable for static WASIX modules\0"
+        .as_ptr()
+        .cast::<raw::c_char>()
+        .cast_mut()
+}
+
+#[cfg(all(target_os = "wasi", target_vendor = "wasmer", not(target_env = "dl")))]
+unsafe fn dlopen(_filename: *const raw::c_char, _flags: raw::c_int) -> *mut raw::c_void {
+    ptr::null_mut()
+}
+
+#[cfg(all(target_os = "wasi", target_vendor = "wasmer", not(target_env = "dl")))]
+unsafe fn dlclose(_handle: *mut raw::c_void) -> raw::c_int { -1 }
+
+#[cfg(all(target_os = "wasi", target_vendor = "wasmer", not(target_env = "dl")))]
+unsafe fn dlsym(_handle: *mut raw::c_void, _symbol: *const raw::c_char) -> *mut raw::c_void {
+    ptr::null_mut()
+}
+
+#[cfg(all(target_os = "wasi", target_vendor = "wasmer", not(target_env = "dl")))]
+unsafe fn dlerror() -> *mut raw::c_char { dl_unavailable() }
+
+#[cfg(all(target_os = "wasi", target_vendor = "wasmer", not(target_env = "dl")))]
+unsafe fn dladdr(_addr: *mut raw::c_void, _info: *mut DlInfo) -> raw::c_int { 0 }
