--- a/src/os/unix/mod.rs
+++ b/src/os/unix/mod.rs
@@ -481,24 +481,60 @@ impl<T> fmt::Debug for Symbol<T> {
 // Platform specific things
 #[cfg_attr(any(target_os = "linux", target_os = "android"), link(name = "dl"))]
 #[cfg_attr(any(target_os = "freebsd", target_os = "dragonfly"), link(name = "c"))]
+#[cfg(not(all(target_os = "wasi", target_vendor = "wasmer", not(target_env = "dl"))))]
 extern "C" {
     fn dlopen(
         filename: *const core::ffi::c_char,
         flags: core::ffi::c_int,
     ) -> *mut core::ffi::c_void;
     fn dlclose(handle: *mut core::ffi::c_void) -> core::ffi::c_int;
     fn dlsym(
         handle: *mut core::ffi::c_void,
         symbol: *const core::ffi::c_char,
     ) -> *mut core::ffi::c_void;
     fn dlerror() -> *mut core::ffi::c_char;
     fn dladdr(addr: *mut core::ffi::c_void, info: *mut DlInfo) -> core::ffi::c_int;
 }
 
 #[repr(C)]
 struct DlInfo {
     dli_fname: *const core::ffi::c_char,
     dli_fbase: *mut core::ffi::c_void,
     dli_sname: *const core::ffi::c_char,
     dli_saddr: *mut core::ffi::c_void,
 }
+
+#[cfg(all(target_os = "wasi", target_vendor = "wasmer", not(target_env = "dl")))]
+fn dl_unavailable() -> *mut core::ffi::c_char {
+    b"dynamic loading is unavailable for static WASIX modules\0"
+        .as_ptr()
+        .cast::<core::ffi::c_char>()
+        .cast_mut()
+}
+
+#[cfg(all(target_os = "wasi", target_vendor = "wasmer", not(target_env = "dl")))]
+unsafe fn dlopen(
+    _filename: *const core::ffi::c_char,
+    _flags: core::ffi::c_int,
+) -> *mut core::ffi::c_void {
+    ptr::null_mut()
+}
+
+#[cfg(all(target_os = "wasi", target_vendor = "wasmer", not(target_env = "dl")))]
+unsafe fn dlclose(_handle: *mut core::ffi::c_void) -> core::ffi::c_int {
+    -1
+}
+
+#[cfg(all(target_os = "wasi", target_vendor = "wasmer", not(target_env = "dl")))]
+unsafe fn dlsym(
+    _handle: *mut core::ffi::c_void,
+    _symbol: *const core::ffi::c_char,
+) -> *mut core::ffi::c_void {
+    ptr::null_mut()
+}
+
+#[cfg(all(target_os = "wasi", target_vendor = "wasmer", not(target_env = "dl")))]
+unsafe fn dlerror() -> *mut core::ffi::c_char { dl_unavailable() }
+
+#[cfg(all(target_os = "wasi", target_vendor = "wasmer", not(target_env = "dl")))]
+unsafe fn dladdr(_addr: *mut core::ffi::c_void, _info: *mut DlInfo) -> core::ffi::c_int { 0 }
