diff --git a/Cargo.toml b/Cargo.toml
index 197a15a..c238989 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -17,7 +17,7 @@ serde_json = "1.0"
 [dependencies.safetensors]
 path = "../../safetensors"
 
-[target.'cfg(target_os = "macos")'.dependencies]
+[target.'cfg(any(target_os = "macos", target_os = "wasi"))'.dependencies]
 libc = "0.2"
 
 # Metal-direct MTLBuffer path is Apple-silicon-only: Shared-mode buffers rely
diff --git a/src/lib.rs b/src/lib.rs
index 6b94a02..0e20550 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -1959,6 +1959,36 @@ fn read_exact_at(file: &File, buf: &mut [u8], offset: u64) -> std::io::Result<()
         }
         Ok(())
     }
+    // wasi is neither cfg(unix) nor cfg(windows), so without this branch the
+    // function body is empty and returns (). std::os::wasi::fs::FileExt is
+    // unstable, so go through libc::pread, which like the Unix pread takes the
+    // offset explicitly and does not touch the fd's seek cursor (thread-safe).
+    #[cfg(target_os = "wasi")]
+    {
+        use std::os::fd::AsRawFd;
+        let mut read = 0usize;
+        while read < buf.len() {
+            let n = unsafe {
+                libc::pread(
+                    file.as_raw_fd(),
+                    buf[read..].as_mut_ptr() as *mut libc::c_void,
+                    buf.len() - read,
+                    (offset + read as u64) as libc::off_t,
+                )
+            };
+            if n < 0 {
+                return Err(std::io::Error::last_os_error());
+            }
+            if n == 0 {
+                return Err(std::io::Error::new(
+                    std::io::ErrorKind::UnexpectedEof,
+                    "read_exact_at: early EOF",
+                ));
+            }
+            read += n as usize;
+        }
+        Ok(())
+    }
 }
 
 /// Run a set of pread(2) jobs in parallel without holding the GIL.
