+/// The fd `path` names under /dev/fd, if any.
+///
+/// /dev/fd/<n> is the calling process's own fd n, so it cannot be a file in the
+/// filesystem: the answer depends on who is asking. Shells hand the name to a
+/// child to read a pipe by (bash builds `<(...)` out of it), so the lookup has
+/// to resolve at open time against the caller's table.
+fn dev_fd_number(path: &str) -> Option<WasiFd> {
+    path.strip_prefix("/dev/fd/")
+        .filter(|rest| !rest.is_empty() && rest.bytes().all(|b| b.is_ascii_digit()))
+        .and_then(|rest| rest.parse().ok())
+}
