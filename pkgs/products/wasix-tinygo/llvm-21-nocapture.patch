diff --git a/compiler/llvmutil/llvm.go b/compiler/llvmutil/llvm.go
--- a/compiler/llvmutil/llvm.go
+++ b/compiler/llvmutil/llvm.go
@@ -220,0 +221,19 @@
+// NoCaptureAttrName returns the LLVM attribute for a pointer that cannot escape.
+func NoCaptureAttrName() string {
+	if Version() >= 21 {
+		return "captures"
+	}
+	return "nocapture"
+}
+
+// IsNoCapture reports whether attr prohibits pointer capture.
+func IsNoCapture(attr llvm.Attribute) bool {
+	if attr.IsNil() {
+		return false
+	}
+	if Version() >= 21 {
+		return attr.GetEnumValue() == 0
+	}
+	return true
+}
+
