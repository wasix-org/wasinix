diff --git a/src/tools/cargo/crates/cargo-util/src/process_builder.rs b/src/tools/cargo/crates/cargo-util/src/process_builder.rs
index f3859080cc8..2618523a5f3 100644
--- a/src/tools/cargo/crates/cargo-util/src/process_builder.rs
+++ b/src/tools/cargo/crates/cargo-util/src/process_builder.rs
@@ -621,0 +622,35 @@ mod imp {
+#[cfg(all(target_os = "wasi", target_vendor = "wasmer"))]
+mod imp {
+    use super::{ProcessBuilder, close_tempfile_and_log_error, debug_force_argfile};
+    use anyhow::Result;
+    use std::io;
+
+    pub fn exec_replace(process_builder: &ProcessBuilder) -> Result<()> {
+        let mut file = None;
+        let status = if debug_force_argfile(process_builder.retry_with_argfile) {
+            let (mut command, argfile) = process_builder.build_command_with_argfile()?;
+            file = Some(argfile);
+            command.status()?
+        } else {
+            let mut command = process_builder.build_command();
+            match command.status() {
+                Ok(status) => status,
+                Err(error) if process_builder.should_retry_with_argfile(&error) => {
+                    let (mut command, argfile) = process_builder.build_command_with_argfile()?;
+                    file = Some(argfile);
+                    command.status()?
+                }
+                Err(error) => return Err(error.into()),
+            }
+        };
+        if let Some(file) = file {
+            close_tempfile_and_log_error(file);
+        }
+        std::process::exit(status.code().unwrap_or(1))
+    }
+
+    pub fn command_line_too_big(err: &io::Error) -> bool {
+        err.raw_os_error() == Some(libc::E2BIG)
+    }
+}
