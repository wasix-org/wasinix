diff --git a/libc-top-half/musl/include/unistd.h b/libc-top-half/musl/include/unistd.h
--- a/libc-top-half/musl/include/unistd.h
+++ b/libc-top-half/musl/include/unistd.h
@@ -204,7 +204,8 @@
 #endif
 long gethostid(void);
-#ifdef __wasilibc_unmodified_upstream /* WASI has no nice or sync */
+/* wasix: nice is a no-op stub, see libc-bottom-half/sources/wasix-stubs.c */
 int nice(int);
+#ifdef __wasilibc_unmodified_upstream /* WASI has no sync */
 void sync(void);
 #endif
 pid_t setpgrp(void);
diff --git a/libc-top-half/musl/include/pthread.h b/libc-top-half/musl/include/pthread.h
--- a/libc-top-half/musl/include/pthread.h
+++ b/libc-top-half/musl/include/pthread.h
@@ -98,9 +98,11 @@
 int pthread_cancel(pthread_t);

-#ifdef __wasilibc_unmodified_upstream /* WASI has no CPU scheduling support. */
+/* wasix: pthread_{get,set}schedparam are defined in libc.a; unhide the decls.
+ * Forward-declare sched_param -- the libc's own build compiles this header
+ * without sched.h's struct in scope, which trips -Wvisibility. */
+struct sched_param;
 int pthread_getschedparam(pthread_t, int *__restrict, struct sched_param *__restrict);
 int pthread_setschedparam(pthread_t, int, const struct sched_param *);
-#endif
 int pthread_setschedprio(pthread_t, int);

 int pthread_once(pthread_once_t *, void (*)(void));
