diff --git a/src/compiler.rs b/src/compiler.rs
--- a/src/compiler.rs
+++ b/src/compiler.rs
@@ -128,6 +128,16 @@
         }));
         command.args(original_args);
         command.args([OsStr::new("--target=wasm32-wasi")]);
+        // Pin the linker by absolute path. With no inputs we hand the args
+        // straight to clang, which includes driver probes that *link* — notably
+        // meson's linker detection (`clang -Wl,--version`). clang otherwise
+        // spawns a bare `wasm-ld` resolved off $PATH, which a sanitized build
+        // env (meson's compiler checks) doesn't carry, so the probe fails with
+        // "Unable to detect linker". wasm-ld lives next to the other tools, and
+        // a compile (which has inputs) never reaches this branch, so the flag
+        // can't trip an "unused argument" warning on conftests.
+        let wasm_ld = user_settings.llvm_location.get_tool_path("wasm-ld");
+        command.arg(format!("-fuse-ld={}", wasm_ld.display()));
         return run_command(command);
     }

