+
+use Exporter 'import';
+
+our @EXPORT_OK = qw(prototype set_prototype subname set_subname);
+
+# naming a sub needs XS; callers keep using the code reference either way
+sub set_subname ($$) { return $_[1] }
+
+sub subname ($) { return 'main::__ANON__' }
+
+sub prototype ($) { return CORE::prototype($_[0]) }
+
+sub set_prototype ($$) { return $_[1] }
