diff -ruN a/cnf/stub/Digest/SHA.pm b/cnf/stub/Digest/SHA.pm
--- a/cnf/stub/Digest/SHA.pm
+++ b/cnf/stub/Digest/SHA.pm
@@ -0,0 +1,106 @@
+package Digest::SHA;
+
+# Digest::SHA is XS. This is SHA-1 in plain perl, enough for the install
+# scripts that hash a string; other algorithms are refused rather than faked.
+
+our $VERSION = '6.05';
+
+use Exporter 'import';
+
+our @EXPORT_OK = qw(sha1 sha1_hex);
+
+sub _rotl
+{
+	my($v, $n) = @_;
+	return ((($v << $n) | ($v >> (32 - $n))) & 0xffffffff);
+}
+
+sub sha1
+{
+	my $msg = join('', @_);
+	my $bits = length($msg) * 8;
+
+	$msg .= chr(0x80);
+	$msg .= "\0" while (length($msg) % 64) != 56;
+	$msg .= pack('N2', int($bits / 4294967296), $bits % 4294967296);
+
+	my @h = (0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0);
+
+	for(my $i = 0; $i < length($msg); $i += 64) {
+		my @w = unpack('N16', substr($msg, $i, 64));
+		for(my $t = 16; $t < 80; $t++) {
+			$w[$t] = _rotl($w[$t-3] ^ $w[$t-8] ^ $w[$t-14] ^ $w[$t-16], 1);
+		}
+
+		my($a, $b, $c, $d, $e) = @h;
+		for(my $t = 0; $t < 80; $t++) {
+			my($f, $k);
+			if($t < 20) {
+				$f = ($b & $c) | ((~$b & 0xffffffff) & $d);
+				$k = 0x5A827999;
+			} elsif($t < 40) {
+				$f = $b ^ $c ^ $d;
+				$k = 0x6ED9EBA1;
+			} elsif($t < 60) {
+				$f = ($b & $c) | ($b & $d) | ($c & $d);
+				$k = 0x8F1BBCDC;
+			} else {
+				$f = $b ^ $c ^ $d;
+				$k = 0xCA62C1D6;
+			}
+			my $tmp = (_rotl($a, 5) + $f + $e + $k + $w[$t]) & 0xffffffff;
+			($e, $d, $c, $b, $a) = ($d, $c, _rotl($b, 30), $a, $tmp);
+		}
+
+		$h[0] = ($h[0] + $a) & 0xffffffff;
+		$h[1] = ($h[1] + $b) & 0xffffffff;
+		$h[2] = ($h[2] + $c) & 0xffffffff;
+		$h[3] = ($h[3] + $d) & 0xffffffff;
+		$h[4] = ($h[4] + $e) & 0xffffffff;
+	}
+
+	return pack('N5', @h);
+}
+
+sub sha1_hex { return unpack('H*', sha1(@_)) }
+
+sub new
+{
+	my($class, $alg) = @_;
+	$alg = 1 unless defined $alg;
+	$alg =~ s/^SHA-?//i;
+	die "Digest::SHA stub implements SHA-1 only, not SHA-$alg" unless $alg eq '1';
+	return bless {data => ''}, ref($class) || $class;
+}
+
+sub add
+{
+	my $self = shift;
+	$self->{data} .= join('', @_);
+	return $self;
+}
+
+sub addfile
+{
+	my($self, $file) = @_;
+	my $fh = $file;
+	unless(ref $file) {
+		open($fh, '<', $file) or die "cannot open $file: $!";
+	}
+	binmode $fh;
+	local $/;
+	$self->{data} .= <$fh>;
+	return $self;
+}
+
+sub digest
+{
+	my $self = shift;
+	my $d = sha1($self->{data});
+	$self->{data} = '';
+	return $d;
+}
+
+sub hexdigest { return unpack('H*', $_[0]->digest) }
+
+1;
