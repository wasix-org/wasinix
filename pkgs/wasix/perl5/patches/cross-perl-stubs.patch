 package File::Temp;
 
+our $VERSION = '0.2311';
+
+use Exporter 'import';
+
+our @EXPORT_OK = qw(tempfile tempdir tmpnam);
+
+# an object from new() is a handle that also reads as its own filename
+use overload '""' => sub { return ${*{$_[0]}}{filename} }, fallback => 1;
+
+my @CHARS = ('A'..'Z', 'a'..'z', '0'..'9');
+
+# The X run belongs to the template alone: the random characters can be X
+# themselves, so a directory joined in first would be rewritten too.
+sub _expand
+{
+	my($patt, $opts) = @_;
+	$patt =~ s{(X+)}{join '', map { $CHARS[int rand @CHARS] } 1 .. length($1)}e;
+	$patt .= $opts->{SUFFIX} if defined $opts->{SUFFIX};
+	return defined $opts->{DIR} ? "$opts->{DIR}/$patt" : $patt;
+}
+
+sub _tmpdir { return defined $ENV{TMPDIR} ? $ENV{TMPDIR} : '/tmp' }
+
 sub tempfile
 {
-	my $patt = shift;
+	my $patt = @_ % 2 ? shift : 'tempXXXXXXXX';
+	my %opts = @_;
+	my $i;
+	my $tmp;
+	my $fh;
+
+	return unless defined $patt;
+	for($i = 0; $i < 10; $i++) {
+		$tmp = _expand($patt, \%opts);
+		next unless sysopen($fh, $tmp, 02 | 0100 | 0200);	# O_RDWR | O_CREAT | O_EXCL
+		return wantarray ? ($fh, $tmp) : $fh;
+	}
+
+	return;
+}
+
+sub tempdir
+{
+	my $patt = @_ % 2 ? shift : 'tempXXXXXXXX';
 	my %opts = @_;
 	my $i;
 	my $tmp;
-	local *FH;
-	
+
 	return unless defined $patt;
 	for($i = 0; $i < 10; $i++) {
-		($tmp = $patt) =~ s{X+}{rand()}e;
-		next unless sysopen(FH, $tmp, 01 | 0100 | 0200);	# O_WRONLY | O_CREAT | O_EXCL
-		return wantarray ? (\*FH, $tmp) : \*FH;
+		$tmp = _expand($patt, \%opts);
+		return $tmp if mkdir $tmp, 0700;
+	}
+
+	return;
+}
+
+sub tmpnam
+{
+	my %opts = (DIR => _tmpdir());
+	my $i;
+	my $tmp;
+
+	for($i = 0; $i < 10; $i++) {
+		$tmp = _expand('tmpXXXXXXXX', \%opts);
+		return $tmp unless -e $tmp;
+	}
+
+	return;
+}
+
+sub new
+{
+	my $class = shift;
+	my %opts = @_;
+	my $patt = defined $opts{TEMPLATE} ? $opts{TEMPLATE} : 'tempXXXXXXXX';
+	my $i;
+	my $tmp;
+	my $fh;
+
+	$opts{DIR} = _tmpdir() unless defined $opts{DIR};
+	for($i = 0; $i < 10; $i++) {
+		$tmp = _expand($patt, \%opts);
+		next unless sysopen($fh, $tmp, 02 | 0100 | 0200);	# O_RDWR | O_CREAT | O_EXCL
+		${*$fh}{filename} = $tmp;
+		return bless $fh, ref($class) || $class;
+	}
+
+	return;
+}
+
+sub newdir
+{
+	my $class = shift;
+	my $patt = @_ % 2 ? shift : 'tempXXXXXXXX';
+	my %opts = @_;
+	my $i;
+	my $tmp;
+
+	$patt = $opts{TEMPLATE} if defined $opts{TEMPLATE};
+	$opts{DIR} = _tmpdir() unless defined $opts{DIR};
+	for($i = 0; $i < 10; $i++) {
+		$tmp = _expand($patt, \%opts);
+		next unless mkdir $tmp, 0700;
+		return bless \$tmp, 'File::Temp::Dir';
 	}
 
 	return;
 }
 
+sub filename
+{
+	return ${*{$_[0]}}{filename};
+}
+
+package File::Temp::Dir;
+
+use overload '""' => sub { return ${$_[0]} }, fallback => 1;
+
+sub dirname { return ${$_[0]} }
+
 1;
diff -ruN a/cnf/stub/IO/File.pm b/cnf/stub/IO/File.pm
--- a/cnf/stub/IO/File.pm
+++ b/cnf/stub/IO/File.pm
@@ -0,0 +1,69 @@
+package IO::File;
+
+our $VERSION = '1.55';
+
+our @ISA = qw(IO::Handle IO::Seekable Exporter);
+
+require IO::Handle;
+require IO::Seekable;
+require Exporter;
+
+# real IO::File re-exports Fcntl's O_ constants; IO::Dir reaches them that way
+our @EXPORT = ();
+eval {
+	require Fcntl;
+	my @o = grep { /^O_/ } @Fcntl::EXPORT;
+	Fcntl->import(@o);
+	push @EXPORT, @o;
+};
+
+my %ansi_mode = (
+	'r'  => '<',
+	'w'  => '>',
+	'a'  => '>>',
+	'r+' => '+<',
+	'w+' => '+>',
+	'a+' => '+>>',
+);
+
+sub new
+{
+	my $class = shift;
+	$class = ref($class) || $class;
+	return IO::Handle::new($class) unless @_;
+	my($file, $mode, $perms) = @_;
+	my $fh;
+	if(defined $perms) {
+		sysopen($fh, $file, $mode, $perms) or return;
+	} elsif(defined $mode) {
+		my $m = exists $ansi_mode{$mode} ? $ansi_mode{$mode} : $mode;
+		open($fh, $m, $file) or return;
+	} else {
+		open($fh, $file) or return;
+	}
+	return bless $fh, $class;
+}
+
+sub open
+{
+	my $fh = shift;
+	my($file, $mode, $perms) = @_;
+	if(defined $perms) {
+		return sysopen($fh, $file, $mode, $perms);
+	} elsif(defined $mode) {
+		my $m = exists $ansi_mode{$mode} ? $ansi_mode{$mode} : $mode;
+		return CORE::open($fh, $m, $file);
+	}
+	return CORE::open($fh, $file);
+}
+
+sub new_tmpfile
+{
+	my $class = shift;
+	require File::Temp;
+	my($fh) = File::Temp::tempfile('tmpXXXXXXXX');
+	return unless $fh;
+	return bless $fh, ref($class) || $class;
+}
+
+1;
diff -ruN a/cnf/stub/IO/Handle.pm b/cnf/stub/IO/Handle.pm
--- a/cnf/stub/IO/Handle.pm
+++ b/cnf/stub/IO/Handle.pm
@@ -0,0 +1,115 @@
+package IO::Handle;
+
+our $VERSION = '1.55';
+
+use Exporter 'import';
+
+our @EXPORT_OK = qw(
+	_IOFBF _IOLBF _IONBF
+	autoflush print printf getline getlines
+	output_field_separator output_record_separator input_record_separator
+	input_line_number format_page_number format_lines_per_page
+	format_lines_left format_name format_top_name
+	format_line_break_characters format_formfeed
+);
+
+use constant {
+	_IOFBF => 0,
+	_IOLBF => 1,
+	_IONBF => 2,
+};
+
+sub new
+{
+	my $class = shift;
+	my $fh = \do { local *HANDLE };
+	return bless $fh, ref($class) || $class;
+}
+
+sub new_from_fd
+{
+	my $class = shift;
+	my $fh = $class->new;
+	return $fh->fdopen(@_) ? $fh : undef;
+}
+
+sub fdopen
+{
+	my($fh, $fd, $mode) = @_;
+	$fd = fileno($fd) if ref $fd;
+	return CORE::open($fh, ($mode =~ /w|>/ ? '>&' : '<&'), $fd);
+}
+
+sub flush
+{
+	my $fh = shift;
+	my $old = select $fh;
+	my $prev = $|;
+	$| = 1;
+	$| = $prev;
+	select $old;
+	return $fh;
+}
+
+sub autoflush
+{
+	my $fh = shift;
+	my $old = select $fh;
+	my $prev = $|;
+	$| = @_ ? shift : 1;
+	select $old;
+	return $prev;
+}
+
+sub printflush
+{
+	my $fh = shift;
+	my $ok = CORE::print {$fh} @_;
+	$fh->flush;
+	return $ok;
+}
+
+sub close   { return CORE::close $_[0] }
+sub fileno  { return CORE::fileno $_[0] }
+sub opened  { return defined CORE::fileno $_[0] }
+sub eof     { return CORE::eof $_[0] }
+sub getc    { return CORE::getc $_[0] }
+sub gets    { my $fh = shift; return scalar <$fh> }
+sub print   { my $fh = shift; return CORE::print {$fh} @_ }
+sub printf  { my $fh = shift; return CORE::printf {$fh} @_ }
+sub binmode { my $fh = shift; return @_ ? CORE::binmode($fh, $_[0]) : CORE::binmode($fh) }
+
+# buffering and error state live in the C library; nothing here reads them back
+sub setbuf   { return }
+sub setvbuf  { return }
+sub error    { return 0 }
+sub clearerr { return 0 }
+sub ungetc   { return }
+sub DESTROY  { return }
+
+sub _open_mode_string
+{
+	my $mode = shift;
+	$mode =~ /^\+?(<|>>?)$/  and return $mode;
+	$mode =~ /^\+?(r|w|a)$/  and return { r => '<', w => '>', a => '>>' }->{$1};
+	return;
+}
+
+sub getline  { my $fh = shift; return scalar <$fh> }
+sub getlines { my $fh = shift; return <$fh> }
+
+# per-handle format and separator state lives in the punctuation variables of
+# whichever handle is selected; nothing here reads it back per handle
+sub output_field_separator  { shift; my $old = $,; $, = shift if @_; return $old }
+sub output_record_separator { shift; my $old = $\; $\ = shift if @_; return $old }
+sub input_record_separator  { shift; my $old = $/; $/ = shift if @_; return $old }
+sub input_line_number       { shift; my $old = $.; eval { $. = shift } if @_; return $old }
+sub format_page_number      { shift; my $old = $%; eval { $% = shift } if @_; return $old }
+sub format_lines_per_page   { shift; my $old = $=; eval { $= = shift } if @_; return $old }
+sub format_lines_left       { shift; my $old = $-; eval { $- = shift } if @_; return $old }
+sub format_name             { shift; my $old = $~; eval { $~ = shift } if @_; return $old }
+sub format_top_name         { shift; my $old = $^; eval { $^ = shift } if @_; return $old }
+sub format_line_break_characters { shift; my $old = $:; eval { $: = shift } if @_; return $old }
+sub format_formfeed         { shift; my $old = $^L; eval { $^L = shift } if @_; return $old }
+
+1;
