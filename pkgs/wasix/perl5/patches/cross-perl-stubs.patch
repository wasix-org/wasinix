diff -ruN a/cnf/stub/List/Util.pm b/cnf/stub/List/Util.pm
--- a/cnf/stub/List/Util.pm
+++ b/cnf/stub/List/Util.pm
@@ -0,0 +1,68 @@
+package List::Util;
+
+our $VERSION = '1.6801';
+
+use Exporter 'import';
+
+our @EXPORT_OK = qw(first any all none sum sum0 max min maxstr minstr uniq uniqstr reduce shuffle pairs);
+
+sub reduce (&@)
+{
+	my $code = shift;
+	no strict 'refs';
+	my $caller = caller;
+	local (*{"${caller}::a"}, *{"${caller}::b"});
+	return undef unless @_;
+	my $a = shift;
+	for my $b (@_) {
+		*{"${caller}::a"} = \$a;
+		*{"${caller}::b"} = \$b;
+		$a = $code->();
+	}
+	return $a;
+}
+
+sub first (&@)
+{
+	my $code = shift;
+	for (@_) {
+		return $_ if $code->();
+	}
+	return undef;
+}
+
+sub any (&@) { my $c = shift; for (@_) { return 1 if $c->() } return 0 }
+sub all (&@) { my $c = shift; for (@_) { return 0 unless $c->() } return 1 }
+sub none (&@) { my $c = shift; for (@_) { return 0 if $c->() } return 1 }
+
+sub sum (@) { return undef unless @_; my $t = 0; $t += $_ for @_; return $t }
+sub sum0 (@) { return 0 unless @_; my $t = 0; $t += $_ for @_; return $t }
+
+sub max (@) { return undef unless @_; my $m = shift; for (@_) { $m = $_ if $_ > $m } return $m }
+sub min (@) { return undef unless @_; my $m = shift; for (@_) { $m = $_ if $_ < $m } return $m }
+sub maxstr (@) { return undef unless @_; my $m = shift; for (@_) { $m = $_ if $_ gt $m } return $m }
+sub minstr (@) { return undef unless @_; my $m = shift; for (@_) { $m = $_ if $_ lt $m } return $m }
+
+sub uniq (@)
+{
+	my %seen;
+	my $undef = 0;
+	return grep { defined $_ ? !$seen{$_}++ : !$undef++ } @_;
+}
+
+sub uniqstr (@) { my %seen; return grep { !$seen{$_}++ } @_ }
+
+sub shuffle (@) { return @_ }
+sub pairs (@)
+{
+	my @pairs;
+	push @pairs, bless([shift, shift], 'List::Util::_Pair') while @_;
+	return @pairs;
+}
+
+package List::Util::_Pair;
+
+sub key   { return $_[0]->[0] }
+sub value { return $_[0]->[1] }
+
+1;
diff -ruN a/cnf/stub/Scalar/Util.pm b/cnf/stub/Scalar/Util.pm
--- a/cnf/stub/Scalar/Util.pm
+++ b/cnf/stub/Scalar/Util.pm
@@ -0,0 +1,79 @@
+package Scalar::Util;
+
+our $VERSION = '1.6801';
+
+use Exporter 'import';
+
+our @EXPORT_OK = qw(
+	blessed reftype refaddr looks_like_number
+	weaken unweaken isweak dualvar isdual isvstring
+	tainted readonly openhandle set_prototype
+);
+
+my %basic = map { $_ => 1 } qw(
+	SCALAR ARRAY HASH CODE REF GLOB LVALUE FORMAT IO VSTRING Regexp
+);
+
+sub reftype ($)
+{
+	ref $_[0] or return undef;
+	my $str = do { no overloading; "$_[0]" };
+	return $1 if $str =~ /=(\w+)\(0x[0-9a-f]+\)$/;
+	return $1 if $str =~ /^(\w+)\(0x[0-9a-f]+\)$/;
+	return undef;
+}
+
+sub blessed ($)
+{
+	my $r = ref $_[0] or return undef;
+	return undef if $basic{$r};
+	return $r;
+}
+
+sub refaddr ($)
+{
+	ref $_[0] or return undef;
+	my $str = do { no overloading; "$_[0]" };
+	return hex $1 if $str =~ /\(0x([0-9a-f]+)\)$/;
+	return undef;
+}
+
+sub looks_like_number ($)
+{
+	my $v = shift;
+	return 0 unless defined $v;
+	return 1 if ref \$v eq 'GLOB';
+	return $v =~ /^\s*[-+]?(\d+\.?\d*|\.\d+)([eE][-+]?\d+)?\s*$/
+	    || $v =~ /^\s*[-+]?(0[xX][0-9a-fA-F]+|Inf(inity)?|NaN)\s*$/i ? 1 : 0;
+}
+
+sub weaken ($) { }
+sub isweak ($) { 0 }
+
+# the numeric half needs XS; callers here only ask whether the target has it
+sub dualvar ($$) { return $_[1] }
+sub isdual ($) { 0 }
+sub isvstring ($) { 0 }
+
+# a prototype cannot be attached to an existing sub without XS; callers here
+# only pass the wrapper along afterwards
+sub set_prototype (&$) { return $_[0] }
+sub unweaken ($) { }
+
+# nothing runs under taint mode here
+sub tainted ($) { 0 }
+
+sub readonly ($)
+{
+	return 0 unless @_;
+	return Internals::SvREADONLY($_[0]) ? 1 : 0;
+}
+
+sub openhandle ($)
+{
+	my $fh = shift;
+	return undef unless ref(\$fh) eq 'GLOB' || ref($fh) eq 'GLOB';
+	return defined(fileno($fh)) ? $fh : undef;
+}
+
+1;
