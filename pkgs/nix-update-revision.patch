@@ -0,0 +1,83 @@
+from __future__ import annotations
+
+from types import SimpleNamespace
+from typing import TYPE_CHECKING, cast
+
+import pytest
+
+from nix_update import parse_args
+from nix_update.errors import UpdateError
+from nix_update.update import replace_source_revision
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+    from nix_update.eval import Package
+
+
+def package(
+    path: Path,
+    line: int,
+    *,
+    rev: str | None = None,
+    tag: str | None = None,
+) -> Package:
+    return cast(
+        "Package",
+        SimpleNamespace(filename=str(path), line=line, rev=rev, tag=tag),
+    )
+
+
+def test_revision_argument() -> None:
+    revision = "A" * 40
+    options = parse_args(["--rev", revision, "hello"])
+    assert options.revision == revision.lower()
+
+
+def test_revision_and_version_are_mutually_exclusive() -> None:
+    with pytest.raises(SystemExit):
+        parse_args(["--rev", "a" * 40, "--version", "1.2.3", "hello"])
+
+
+def test_replace_literal_revision(tmp_path: Path) -> None:
+    path = tmp_path / "package.nix"
+    path.write_text('src = fetchFromGitHub {\n  rev = "old";\n};\n')
+    replace_source_revision(package(path, 1, rev="old"), "a" * 40)
+    assert f'rev = "{"a" * 40}";' in path.read_text()
+
+
+def test_replace_interpolated_tag_near_inherited_source(tmp_path: Path) -> None:
+    path = tmp_path / "package.nix"
+    path.write_text(
+        'other = fetchFromGitHub { rev = "unrelated"; };\n'
+        "src = fetchFromGitHub {\n"
+        '  tag = "v${version}";\n'
+        "};\n"
+        "package = buildRustPackage { inherit version src; };\n",
+    )
+    replace_source_revision(package(path, 5, tag="v1.2.3"), "b" * 40)
+    source = path.read_text()
+    assert 'rev = "unrelated";' in source
+    assert f'rev = "{"b" * 40}";' in source
+    assert "tag =" not in source
+
+
+def test_replace_interpolated_tag_after_direct_source(tmp_path: Path) -> None:
+    path = tmp_path / "package.nix"
+    path.write_text(
+        'old = fetchFromGitHub {\n  rev = "unrelated";\n};\n'
+        "src = fetchFromGitHub {\n"
+        '  tag = "v${version}";\n'
+        "};\n",
+    )
+    replace_source_revision(package(path, 4, tag="v1.2.3"), "c" * 40)
+    source = path.read_text()
+    assert 'rev = "unrelated";' in source
+    assert f'rev = "{"c" * 40}";' in source
+
+
+def test_missing_source_selector_fails(tmp_path: Path) -> None:
+    path = tmp_path / "package.nix"
+    path.write_text('version = "1.2.3";\n')
+    with pytest.raises(UpdateError, match="Could not find"):
+        replace_source_revision(package(path, 1), "c" * 40)
