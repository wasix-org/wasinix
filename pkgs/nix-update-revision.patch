--- a/nix_update/update.py
+++ b/nix_update/update.py
@@ -3,0 +4 @@
+import re
@@ -20,0 +22,46 @@
+SOURCE_SELECTOR = re.compile(
+    r"^(?P<indent>[ \t]*)(?:tag|rev)[ \t]*=[ \t]*(?P<value>[^;\n]+);",
+    re.MULTILINE,
+)
+
+
+def replace_source_revision(package: Package, revision: str) -> None:
+    path = Path(package.filename)
+    source = path.read_text()
+    matches = list(SOURCE_SELECTOR.finditer(source))
+    if not matches:
+        msg = f"Could not find a tag or rev declaration in {package.filename}"
+        raise UpdateError(msg)
+
+    old_selector = package.tag or package.rev
+    exact = [
+        match
+        for match in matches
+        if old_selector is not None and old_selector in match.group("value")
+    ]
+    candidates = exact or matches
+
+    position_line = source.splitlines()[package.line - 1]
+    selector_follows_position = re.search(r"\bsrc[ \t]*=", position_line) is not None
+
+    def distance(match: re.Match[str]) -> tuple[int, bool]:
+        line = source.count("\n", 0, match.start()) + 1
+        wrong_side = (
+            line < package.line if selector_follows_position else line > package.line
+        )
+        return (abs(line - package.line), wrong_side)
+
+    selector = min(candidates, key=distance)
+    replacement = f'{selector.group("indent")}rev = "{revision}";'
+    path.write_text(source[: selector.start()] + replacement + source[selector.end() :])
+
+
+def requested_revision(version: Version) -> str | None:
+    if not version.is_revision:
+        return None
+    if version.rev is None:
+        msg = "Revision update has no revision"
+        raise ValueError(msg)
+    return version.rev
+
+
