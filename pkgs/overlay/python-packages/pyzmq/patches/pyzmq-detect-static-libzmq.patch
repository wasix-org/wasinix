pyzmq's ZMQ_PREFIX=auto find_package(ZeroMQ) branch only recognises the shared
`libzmq` target, and because ZeroMQ_FOUND is then true it skips the pkg-config
fallback. A static-only libzmq install (overlay/packages/zeromq.nix) exports the
`libzmq-static` target instead, which pyzmq already handles in its bundled path
and its link step (it adds stdc++ for it). Teach the auto-detect to pick it up;
the static target carries libsodium transitively. TODO: upstream.
diff --git a/CMakeLists.txt b/CMakeLists.txt
index 5c58cb7..25a1ee3 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -120,6 +120,9 @@ if (ZMQ_PREFIX STREQUAL "auto")
     set(libzmq_target "libzmq")
     get_target_property(_ZMQ_LOCATION libzmq IMPORTED_LOCATION)
     message(CHECK_PASS "Found with cmake: ${_ZMQ_LOCATION}")
+  elseif (ZeroMQ_FOUND AND TARGET libzmq-static)
+    set(libzmq_target "libzmq-static")
+    message(CHECK_PASS "Found with cmake: libzmq-static")
   endif()
 
   if (NOT ZeroMQ_FOUND)
