The SuperLU half of scipy-hand-c-blas-fortran-charlen.patch, for the releases up
to 1.17 that predate scipy's Fortran-to-C migration: the optimize, linalg,
integrate, PROPACK and arnaud declaration headers the full patch also fixes do
not exist there, and those routines are still Fortran, where flang emits the
hidden CHARACTER lengths on both sides of the call.

SuperLU's bundled C code declares the Fortran BLAS symbols without the hidden
lengths, which traps under wasm's strictly typed call_indirect
(signature_mismatch:<sym>); each header binds the flang symbol to a declaration
that carries them.

--- a/scipy/sparse/linalg/_dsolve/SuperLU/SRC/slu_sdefs.h
+++ b/scipy/sparse/linalg/_dsolve/SuperLU/SRC/slu_sdefs.h
@@ -273,6 +273,51 @@
 extern void sgemv_(char *, slu_blasint *, slu_blasint *, float *, float *a, slu_blasint *,
                   float *, slu_blasint *, float *, float *, slu_blasint *);
 
+
+/*
+ * WASIX: flang compiles the Netlib reference BLAS/LAPACK with the standard F77
+ * hidden-CHARACTER-length ABI: one trailing size_t per CHARACTER*1 flag arg
+ * (TRANS/UPLO/DIAG/SIDE/JOBZ/...), appended after ALL explicit args. These
+ * declarations omit those lengths (and declare ?getrf/?getri as CBLAS_INT-
+ * returning though the flang subroutines return void), which is harmless where a
+ * lax C ABI ignores the difference but traps under wasm's strictly typed
+ * call_indirect / dylib import (signature_mismatch:<sym>). For each affected
+ * routine, bind the true flang symbol to a private C name via an asm label (with
+ * the hidden lengths / void return), then redirect the public name to a static
+ * inline wrapper that appends length 1 per char arg (every wrapped arg is
+ * CHARACTER*1; LSAME reads only the first character). The wrapper needs a
+ * DISTINCT name from the true symbol: reusing it makes the asm label bind the
+ * call back to the wrapper (self-recursion under wasm-ld). Counts/return types
+ * verified against the flang-built reference lib arities. See scipy.nix.
+ */
+#if defined(__wasi__) || defined(__wasm__)
+#include <stddef.h>
+#ifndef SCIPY_WASIX_STR
+#define SCIPY_WASIX_STR2(x) #x
+#define SCIPY_WASIX_STR(x) SCIPY_WASIX_STR2(x)
+#endif
+
+#undef sgemm_
+extern void scipy_wasix_real_sgemm(const char* a0, const char* a1, const slu_blasint* a2, const slu_blasint* a3, const slu_blasint* a4, const float* a5, const float* a6, const slu_blasint* a7, const float* a8, const slu_blasint* a9, const float* a10, float* a11, const slu_blasint* a12, size_t, size_t) __asm__(SCIPY_WASIX_STR(SLU_BLAS_FUNC(sgemm)));
+static inline void scipy_wasix_slu_sgemm(const char* a0, const char* a1, const slu_blasint* a2, const slu_blasint* a3, const slu_blasint* a4, const float* a5, const float* a6, const slu_blasint* a7, const float* a8, const slu_blasint* a9, const float* a10, float* a11, const slu_blasint* a12) { scipy_wasix_real_sgemm(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, 1, 1); }
+#define sgemm_ scipy_wasix_slu_sgemm
+
+#undef strsv_
+extern void scipy_wasix_real_strsv(char* a0, char* a1, char* a2, slu_blasint* a3, float* a4, slu_blasint* a5, float* a6, slu_blasint* a7, size_t, size_t, size_t) __asm__(SCIPY_WASIX_STR(SLU_BLAS_FUNC(strsv)));
+static inline void scipy_wasix_slu_strsv(char* a0, char* a1, char* a2, slu_blasint* a3, float* a4, slu_blasint* a5, float* a6, slu_blasint* a7) { scipy_wasix_real_strsv(a0, a1, a2, a3, a4, a5, a6, a7, 1, 1, 1); }
+#define strsv_ scipy_wasix_slu_strsv
+
+#undef strsm_
+extern void scipy_wasix_real_strsm(char* a0, char* a1, char* a2, char* a3, slu_blasint* a4, slu_blasint* a5, float* a6, float* a7, slu_blasint* a8, float* a9, slu_blasint* a10, size_t, size_t, size_t, size_t) __asm__(SCIPY_WASIX_STR(SLU_BLAS_FUNC(strsm)));
+static inline void scipy_wasix_slu_strsm(char* a0, char* a1, char* a2, char* a3, slu_blasint* a4, slu_blasint* a5, float* a6, float* a7, slu_blasint* a8, float* a9, slu_blasint* a10) { scipy_wasix_real_strsm(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, 1, 1, 1, 1); }
+#define strsm_ scipy_wasix_slu_strsm
+
+#undef sgemv_
+extern void scipy_wasix_real_sgemv(char * a0, slu_blasint * a1, slu_blasint * a2, float * a3, float * a4, slu_blasint * a5, float * a6, slu_blasint * a7, float * a8, float * a9, slu_blasint * a10, size_t) __asm__(SCIPY_WASIX_STR(SLU_BLAS_FUNC(sgemv)));
+static inline void scipy_wasix_slu_sgemv(char * a0, slu_blasint * a1, slu_blasint * a2, float * a3, float * a4, slu_blasint * a5, float * a6, slu_blasint * a7, float * a8, float * a9, slu_blasint * a10) { scipy_wasix_real_sgemv(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, 1); }
+#define sgemv_ scipy_wasix_slu_sgemv
+#endif  /* wasm charlen redirects */
+
