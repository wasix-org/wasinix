diff -ruN a/include/grpc/support/port_platform.h b/include/grpc/support/port_platform.h
--- a/include/grpc/support/port_platform.h	2026-07-06 12:57:47.109588266 +0200
+++ b/include/grpc/support/port_platform.h	2026-07-06 12:58:40.196701224 +0200
@@ -523,6 +523,37 @@
 #else /* _LP64 */
 #define GPR_ARCH_32 1
 #endif /* _LP64 */
+#elif defined(__wasi__)
+// wasix; clang has no wasix target yet, so probe __wasi__
+#define GPR_PLATFORM_STRING "wasix"
+#ifndef _BSD_SOURCE
+#define _BSD_SOURCE
+#endif
+#ifndef _DEFAULT_SOURCE
+#define _DEFAULT_SOURCE
+#endif
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#define GPR_WASIX 1
+#define GPR_CPU_POSIX 1
+#define GPR_GCC_ATOMIC 1
+#define GPR_POSIX_ENV 1
+#define GPR_POSIX_STRING 1
+#define GPR_POSIX_SYNC 1
+// no GPR_POSIX_SUBPROCESS: would need fork+exec
+// no GPR_HAS_PTHREAD_H: breaks the build (see wasix port notes)
+#define GPR_GETPID_IN_UNISTD_H 1
+#define GPR_POSIX_LOG 1
+#define GPR_POSIX_TMPFILE 1
+#define GPR_POSIX_STAT 1
+#define GPR_POSIX_TIME 1
+#define GPR_LINUX_PTHREAD_NAME 1
+#ifdef _LP64
+#define GPR_ARCH_64 1
+#else /* _LP64 */
+#define GPR_ARCH_32 1
+#endif /* _LP64 */
 #else
 #error "Could not auto-detect platform"
 #endif
diff -ruN a/src/core/lib/iomgr/port.h b/src/core/lib/iomgr/port.h
