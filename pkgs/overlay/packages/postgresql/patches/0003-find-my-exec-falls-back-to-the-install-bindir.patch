find_my_exec resolves a program either from a slash-bearing argv[0] or by
searching PATH. A webc command arrives as a bare name and the guest PATH does
not contain the installation, so both fail: every program logs "could not find
a ... to execute", and initdb and pg_ctl cannot locate the backend at all.
WASIX_BINDIR is the install bindir, passed in by the build.

--- a/src/common/exec.c
+++ b/src/common/exec.c
@@ -221,6 +221,19 @@
 		} while (*endp);
 	}
 
+#if defined(__wasi__) && defined(WASIX_BINDIR)
+
+	/*
+	 * A WASI runner passes a bare command name and its PATH does not name the
+	 * installation, so neither lookup above can find us.  Fall back to the
+	 * directory the programs were installed in.
+	 */
+	join_path_components(retpath, WASIX_BINDIR, argv0);
+	canonicalize_path(retpath);
+	if (validate_exec(retpath) == 0)
+		return normalize_exec_path(retpath);
+#endif
+
 	log_error(errcode(ERRCODE_UNDEFINED_FILE),
 			  _("could not find a \"%s\" to execute"), argv0);
 	return -1;
