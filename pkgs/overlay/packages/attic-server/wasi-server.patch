+use std::env;
+use std::fs;
+use std::io;
+use std::path::{Path, PathBuf};
+
+pub struct BaseDirectories {
+    config_home: Option<PathBuf>,
+    data_home: Option<PathBuf>,
+    prefix: PathBuf,
+}
+
+impl BaseDirectories {
+    pub fn with_prefix<P: AsRef<Path>>(prefix: P) -> Self {
+        let home = env::var_os("HOME").map(PathBuf::from);
+        let config_home = env::var_os("XDG_CONFIG_HOME")
+            .map(PathBuf::from)
+            .filter(|path| path.is_absolute())
+            .or_else(|| home.as_ref().map(|home| home.join(".config")));
+        let data_home = env::var_os("XDG_DATA_HOME")
+            .map(PathBuf::from)
+            .filter(|path| path.is_absolute())
+            .or_else(|| home.map(|home| home.join(".local/share")));
+
+        Self {
+            config_home,
+            data_home,
+            prefix: prefix.as_ref().to_owned(),
+        }
+    }
+
+    pub fn place_config_file<P: AsRef<Path>>(&self, path: P) -> io::Result<PathBuf> {
+        let config_home = self.config_home.as_ref().ok_or_else(missing_home)?;
+        let path = config_home.join(&self.prefix).join(path);
+        if let Some(parent) = path.parent() {
+            fs::create_dir_all(parent)?;
+        }
+        Ok(path)
+    }
+
+    pub fn create_data_directory<P: AsRef<Path>>(&self, path: P) -> io::Result<PathBuf> {
+        let data_home = self.data_home.as_ref().ok_or_else(missing_home)?;
+        let path = data_home.join(&self.prefix).join(path);
+        fs::create_dir_all(&path)?;
+        Ok(path)
+    }
+}
+
+fn missing_home() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::NotFound,
+        "neither the relevant XDG home nor HOME is set",
+    )
+}
