diff --git a/extension/extension_build_tools.cmake b/extension/extension_build_tools.cmake
index 6a05070..e3493c7 100644
--- a/extension/extension_build_tools.cmake
+++ b/extension/extension_build_tools.cmake
@@ -112,7 +112,10 @@ function(build_loadable_extension_directory NAME ABI_TYPE OUTPUT_DIRECTORY EXTEN
 
     string(TOUPPER ${NAME} EXTENSION_NAME_UPPERCASE)
 
-    if(EMSCRIPTEN)
+    # wasi has no dynamic extension loading (DISABLE_EXTENSION_LOAD); build the
+    # loadable extension as a STATIC lib like emscripten does, so the SHARED link
+    # (with -Wl,--exclude-libs,ALL, which wasm-ld rejects) is never run.
+    if(EMSCRIPTEN OR CMAKE_SYSTEM_NAME MATCHES "WASI|Wasi")
         add_library(${TARGET_NAME} STATIC ${FILES})
     else()
         add_library(${TARGET_NAME} SHARED ${FILES})
