diff --git a/src/unix/dl.c b/src/unix/dl.c
index 80b3333..cf8aa95 100644
--- a/src/unix/dl.c
+++ b/src/unix/dl.c
@@ -22,11 +22,42 @@
 #include "uv.h"
 #include "internal.h"
 
+#ifndef __wasi__ /* wasix-libc has no dlfcn.h */
 #include <dlfcn.h>
+#endif
 #include <errno.h>
 #include <string.h>
 #include <locale.h>
 
+#ifdef __wasi__ /* wasix-libc has no dlfcn.h */
+
+int uv_dlopen(const char* filename, uv_lib_t* lib) {
+  lib->handle = NULL;
+  lib->errmsg = uv__strdup("dlopen is not supported on this platform");
+  return -1;
+}
+
+
+void uv_dlclose(uv_lib_t* lib) {
+  uv__free(lib->errmsg);
+  lib->errmsg = NULL;
+}
+
+
+int uv_dlsym(uv_lib_t* lib, const char* name, void** ptr) {
+  *ptr = NULL;
+  uv__free(lib->errmsg);
+  lib->errmsg = uv__strdup("dlsym is not supported on this platform");
+  return -1;
+}
+
+
+const char* uv_dlerror(const uv_lib_t* lib) {
+  return lib->errmsg ? lib->errmsg : "no error";
+}
+
+#else
+
 static int uv__dlerror(uv_lib_t* lib);
 
 
@@ -78,3 +109,5 @@ static int uv__dlerror(uv_lib_t* lib) {
     return 0;
   }
 }
+
+#endif /* __wasi__ */
