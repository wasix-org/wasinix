+fn watch_shutdown_signal() -> watch::Receiver<bool> {
+	let (send_cancel, watch_cancel) = watch::channel(false);
+	tokio::spawn(async move {
+		std::future::pending::<()>().await;
+		send_cancel.send(true).unwrap();
+	});
+	watch_cancel
