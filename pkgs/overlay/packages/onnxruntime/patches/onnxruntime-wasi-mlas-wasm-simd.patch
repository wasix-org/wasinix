Compile MLAS's wasm-SIMD kernels on wasi, not the scalar ones.

mlas.h keys MLAS_TARGET_WASM_{SIMD,RELAXED_SIMD} off __wasm_simd128__ /
__wasm_relaxed_simd__, which the wasix toolchain always defines (-msimd128
-mrelaxed-simd). So mlasi.h references MlasGemmU8X8DispatchWasm{,Relaxed}Simd. But
this cmake only globs those kernels under CMAKE_SYSTEM_NAME == Emscripten; for any
other wasm system (wasi) it falls through to the generic branch and globs the
scalar kernels instead, leaving those dispatch symbols undefined -- the pybind
module then fails to load ("Unresolved global MlasGemmU8X8DispatchWasmSimd,
Missing export"). Route wasi through the same wasm branch (with
onnxruntime_ENABLE_WEBASSEMBLY_SIMD / _RELAXED_SIMD set to match the toolchain
flags).

Upstream fix: select the wasm MLAS sources on any wasm target, not only Emscripten.

diff --git a/cmake/onnxruntime_mlas.cmake b/cmake/onnxruntime_mlas.cmake
--- a/cmake/onnxruntime_mlas.cmake
+++ b/cmake/onnxruntime_mlas.cmake
@@ -357,7 +357,7 @@ function ()
   set(mlas_private_compile_definitions ${mlas_private_compile_definitions} PARENT_SCOPE)
 endfunction ()

-if (CMAKE_SYSTEM_NAME STREQUAL "Emscripten")
+if (CMAKE_SYSTEM_NAME STREQUAL "Emscripten" OR CMAKE_SYSTEM_NAME MATCHES "Wasi")
   if (onnxruntime_ENABLE_WEBASSEMBLY_SIMD)
     file(GLOB_RECURSE mlas_platform_srcs
       "${MLAS_SRC_DIR}/wasm_simd/*.cpp"
